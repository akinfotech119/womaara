<div
  class="hero-content-block"
  style="
    --hero-content-bg: {{ block.settings.background_color }};
    --hero-content-padding: {{ block.settings.padding }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="hero-content-inner">

    {% content_for "blocks" %}

  </div>
</div>

{% schema %}
{
  "name": "Hero Content",

  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Inner box background",
      "default": "#5591BC"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Inner box padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],

  "blocks": [
    {
      "type": "_hero-heading"
    },
    {
      "type": "_hero-description"
    },
    {
      "type": "_hero-button"
    },
    {
      "type": "_hero-arrows"
    }
  ]
}
{% endschema %}
