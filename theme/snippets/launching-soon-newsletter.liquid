<div class="launching_soon_newsletter">
  <div class="newsletter_info">
    <div class="newsletter_info_inner">
      Subscribe for early access, exclusive discounts, and a chance to receive a free Womaara hamper.
    </div>
  </div>
  <div class="newsletter_inner">
    {%- form 'customer', class: 'email-signup__form spacing-style' %}
      <div class="email-signup__input-group">
        <label
          for="EmailInput-{{ section.id }}"
          class="visually-hidden"
        >
          {{ 'blocks.email_signup.label' | t }}
        </label>
        <input
          id="EmailInput-{{ section.id }}"
          class="email-signup__input"
          type="email"
          name="contact[email]"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          placeholder="Email"
          required
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="Email-signup__message-error-{{ section.id }}"
          {% elsif form.posted_successfully? %}
            aria-describedby="Email-signup__message-success-{{ section.id }}"
          {% endif %}
        >
        {%- if form.errors -%}
          <div
            id="Email-signup__message-error-{{ section.id }}"
            class="email-signup__message email-signup__message--error"
            tabindex="-1"
          >
            <svg
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
              focusable="false"
              aria-hidden="true"
              class="icon-error"
            >
              {%- render 'icon', icon: 'error'  -%}
            </svg>
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div
            id="Email-signup__message-success-{{ section.id }}"
            class="email-signup__message email-signup__message--success"
            tabindex="-1"
          >
            <span class="svg-wrapper icon-success">
              {{ 'icon-checkmark.svg' | inline_asset_content }}
            </span>
            <p class="email-signup__message-text">{{ 'blocks.email_signup.success' | t }}</p>
          </div>
        {%- endif -%}
      </div>
      <div class="button_inner">
        <button class="email-signup__button">notify</button>
      </div>
    {% endform %}
  </div>
</div>

<style>
  .launching_soon_main .launching_soon_newsletter { display: flex ; justify-content: space-between; padding: 54px 0 76px; gap: 80px; border-top: 1px solid #3d30403d; }
  .launching_soon_main .launching_soon_newsletter .newsletter_info { width: 100%; /*max-width: 27.778vw;*/ max-width: 390px; }
  .launching_soon_main .launching_soon_newsletter .newsletter_info_inner { font-size: 16px; font-weight: 300; line-height: 140%; }

  .launching_soon_main .launching_soon_newsletter .newsletter_inner form { flex-direction: row; gap:15px; justify-content: flex-end; } 
  .launching_soon_main .launching_soon_newsletter .newsletter_inner .email-signup__input-group { display: flex; flex-direction: column; max-width: 330px;
    min-width: unset; width: 100%; }
    .launching_soon_main .launching_soon_newsletter .newsletter_inner .email-signup__input:focus-visible {
      outline:none;
    }
  .launching_soon_main .launching_soon_newsletter .newsletter_inner .email-signup__input { border-radius: 500px; border: 1px solid #3D3140; background: #FFF; padding: 10.5px 24px; font-size: 15px; font-weight: 300; line-height: 140%; width: 100%; max-width:330px; }
  .launching_soon_main .launching_soon_newsletter .button_inner button { padding: 11.5px; font-size: 16px; font-weight: 600; line-height: 120%; letter-spacing: 0.64px; text-transform: uppercase; width: 100%; border-radius: 500px; border: 1px solid #3D3140; background: #FFE4A3; }
  .launching_soon_main .launching_soon_newsletter .button_inner {
    max-width:170px;
    width:100%;
  }
   .launching_soon_main .launching_soon_newsletter .newsletter_inner {
    flex: 1;
  }
  @media screen and (min-width: 1440px){
    .launching_soon_main .launching_soon_newsletter .newsletter_info_inner{font-size: 18px;}
    .launching_soon_main .launching_soon_newsletter {
          gap: 130px;
    }
  }
  
  @media screen and (min-width: 750px) and (max-width: 989px){
    .launching_soon_main .launching_soon_newsletter { max-width: 560px; margin: auto; }
    .launching_soon_main .launching_soon_newsletter .button_inner button { width: 100%; }
  } 
  
  @media screen and (max-width: 989px){
    .launching_soon_main .launching_soon_newsletter { padding: 30px 0 31px; flex-direction: column; gap: 20px;         max-width: 295px;
        margin: 0 auto;}
    .launching_soon_main .launching_soon_newsletter .newsletter_info { text-align: center; max-width: 100%; margin: 0 auto; }
    .launching_soon_main .launching_soon_newsletter .newsletter_info_inner { font-size: 13px; line-height: 120%; }
    
    .launching_soon_main .launching_soon_newsletter .newsletter_inner { width: 100%; max-width: 66.67vw; margin: auto; }
    .launching_soon_main .launching_soon_newsletter .newsletter_inner form { flex-direction: column; max-width: 260px; margin: 0 auto;}
    .launching_soon_main .launching_soon_newsletter .newsletter_inner .email-signup__input-group { width: 100%; }
    .launching_soon_main .launching_soon_newsletter .newsletter_inner .email-signup__input { padding: 6px 14px; font-size: 13px; min-width: auto; text-align: center; }
    .launching_soon_main .launching_soon_newsletter .button_inner button { padding: 6.5px; font-size: 14px; }
    .launching_soon_main .launching_soon_newsletter .button_inner {
    max-width:100%;
  }
  }
</style>
