{%- if testimonial_lists.image_or_video.value != blank or testimonial_lists.heading_text.value != blank or testimonial_lists.details_text.value != blank or testimonial_lists.author_text.value != blank -%}
    <div class="Index_testimonial_grid_main_new">
        <div class="Index_testimonial_grid_inner_new">
            {%- if testimonial_lists.image_or_video.value != blank -%}
                {%- if testimonial_lists.image_or_video.value contains "files" -%}
                    <div class="Index_testimonial_grid_media_new">
                        {% render 'responsive-image-new',
                            desktop_image: testimonial_lists.image_or_video.value,
                            mobile_image: testimonial_lists.image_or_video.value,
                            class: 'Static_image_new',
                            sizes: '(max-width: 749px) 100vw, 100vw',
                            fetchpriority: 'low', 
                        %}
                    </div>
                {%- else -%}
                    <div class="Index_testimonial_grid_media_new">
                        {{ testimonial_lists.image_or_video.value | video_tag: class:'Static_video_new', image_size: 'master', controls: false, autoplay: true, loop: true }}
                    </div>
                {%- endif -%}
            {%- endif -%}
            {%- if testimonial_lists.heading_text.value != blank or testimonial_lists.details_text.value != blank or testimonial_lists.author_text.value != blank -%}
